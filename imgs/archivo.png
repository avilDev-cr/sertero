="lazy"></div><div class="ScrollingLogos__Logo-sc-1ueu83-3 kPbIpl gray"><img class="UpKeep" src="./archivo_files/1624814005-aramark-logo.svg" alt="" loading="lazy"></div><div class="ScrollingLogos__Logo-sc-1ueu83-3 kPbIpl gray"><img class="UpKeep" src="./archivo_files/1624814104-subway-logo.svg" alt="" loading="lazy"></div></div><div class="ScrollingLogos__Overlay-sc-1ueu83-1 doLbNz"></div></div></div></section><section id="card-deck" class="CardDeck__Section-sc-1rnssds-0 lbBfcS"><div class="ParallaxGrid__BackgroundImage-sc-93wl34-0 juqoUn parallax-grid " loading="lazy" style="background-position: center 731px;"></div><div class="CardDeck__Wrapper-sc-1rnssds-1 iZGRfu"><div class="CardDeck__Heading-sc-1rnssds-2 czDxik"><div class="HeadingComponentstyled__Container-sc-2r5tjc-0 iTthjT heading-container"><div class="HeadingComponentstyled__Wrapper-sc-2r5tjc-1 flEaWx heading-container"><div class="HeadingComponentstyled__Top-sc-2r5tjc-2 jKpGTc"><h2 class="HeadingComponentstyled__Heading-sc-2r5tjc-5 cdGOpU">Rompe récords, no tu equipo de entrenamiento.</h2></div></div></div></div><div class="CardDeck__Grid-sc-1rnssds-4 dMQYDm card-deck-grid"><div class="indexstyled__Container-sc-1kiezdl-0 jnyKFD"><div class="indexstyled__Asset-sc-1kiezdl-2 jHcKgi"><div class="indexstyled__IconCircle-sc-1kiezdl-3 ayWsk"><svg width="100%" height="100%" class="Icon__Container-sc-1fpon3i-0 jKxrWY" role="presentation"><use href="/sprites/custom.svg#folder-open"></use></svg></div></div><div class="indexstyled__Body-sc-1kiezdl-5 gATAxT c-card-body"><div class="indexstyled__Text-sc-1kiezdl-6 eEiegx"><p class="heading">Mantén tu gimnasio seguro y limpio</p><div class="subhead">Intercambia las inspecciones en papel que se olvidan o se pierden. UpKeep une tu trabajo de mantenimiento en nuestra plataforma móvil, para que tu equipo de limpieza y técnicos sepan exactamente qué tareas de alta prioridad deben atender y solucionar.</div></div></div></div><div class="indexstyled__Container-sc-1kiezdl-0 jnyKFD"><div class="indexstyled__Asset-sc-1kiezdl-2 jHcKgi"><div class="indexstyled__IconCircle-sc-1kiezdl-3 ayWsk"><svg width="100%" height="100%" class="Icon__Container-sc-1fpon3i-0 jKxrWY" role="presentation"><use href="/sprites/custom.svg#wrench"></use></svg></div></div><div class="indexstyled__Body-sc-1kiezdl-5 gATAxT c-card-body"><div class="indexstyled__Text-sc-1kiezdl-6 eEiegx"><p class="heading">Asegurar equipo duradero con inspecciones</p><div class="subhead">Obtenga el mayor valor de las caras máquinas de remo y las cintas de correr. Logre el máximo retorno de la inversión al tener a los técnicos siguiendo listas de mantenimiento preventivo y revisando periódicamente los ventiladores y correas para detectar desgaste.</div></div></div></div><div class="indexstyled__Container-sc-1kiezdl-0 jnyKFD"><div class="indexstyled__Asset-sc-1kiezdl-2 jHcKgi"><div class="indexstyled__IconCircle-sc-1kiezdl-3 ayWsk"><svg width="100%" height="100%" class="Icon__Container-sc-1fpon3i-0 jKxrWY" role="presentation"><use href="/sprites/custom.svg#person-walking"></use></svg></div></div><div class="indexstyled__Body-sc-1kiezdl-5 gATAxT c-card-body"><div class="indexstyled__Text-sc-1kiezdl-6 eEiegx"><p class="heading">Centralizar las solicitudes de mantenimiento en un solo lugar</p><div class="subhead">¿El elíptico no funciona? Tome una foto de la pieza rota, anote la foto y cárguela al portal de solicitudes en UpKeep. Un administrador puede asignar el trabajo al técnico más cercano para que lo atienda antes de que se convierta en un problema de seguridad mayor para los clientes.</div></div></div></div><div class="indexstyled__Container-sc-1kiezdl-0 jnyKFD"><div class="indexstyled__Asset-sc-1kiezdl-2 jHcKgi"><div class="indexstyled__IconCircle-sc-1kiezdl-3 ayWsk"><svg width="100%" height="100%" class="Icon__Container-sc-1fpon3i-0 jKxrWY" role="presentation"><use href="/sprites/custom.svg#list"></use></svg></div></div><div class="indexstyled__Body-sc-1kiezdl-5 gATAxT c-card-body"><div class="indexstyled__Text-sc-1kiezdl-6 eEiegx"><p class="heading">Centralize maintenance requests in one place</p><div class="subhead"><p><span style="font-weight: 400;">Is an elliptical not working? Snap a picture of the broken part, annotate the photo with a clear description, and upload a maintenance request on Upkeep. Then, an admin or manager will create a work order or assign a technician to fulfill the repairs. Avoid texting or emailing multiple people to get the job done. Communicate and assign work orders and tasks from one location. With Upkeep, you can remain as organized as possible to ensure operations run as smoothly as your treadmills.</span></p></div></div></div></div></div></div></section><div class="CaseStudySliderstyled__Section-sc-1h2jznj-0 ipPBwR"><div class="ParallaxGrid__BackgroundImage-sc-93wl34-0 juqoUn parallax-grid " loading="eager" style="background-position: center 17px;"></div><div class="CaseStudySliderstyled__Wrapper-sc-1h2jznj-1 cwZCmA"><div class="CaseStudySliderstyled__Header-sc-1h2jznj-2 jlhREO"><h2 class="CaseStudySliderstyled__Heading-sc-1h2jznj-3 bbA-DlO">Explorar Estudios de Casos</h2><a variant="Link - Steel" aria-label="Explore más estudios de casos" data-link-type="internal-link" class="CallToActionstyled__applySharedStyles-sc-2h7j2i-0 gUSfBW  " styles="font-size:,1.125,rem;font-weight:,700,;font-family:,&#39;Gilroy&#39;,,sans-serif;line-height:,1.75,rem;letter-spacing:,0,rem;margin-bottom:0;text-transform:,none,;, justify-content:flex-start;" href="https://upkeep.com/es/product/customers/">Explore más estudios de casos<div class="CallToActionstyled__IconContainer-sc-2h7j2i-1 bwwgTo"><svg width="16px" height="16px" class="Icon__Container-sc-1fpon3i-0 iLHiro" role="presentation"><use href="/sprites/custom.svg#chevron-right"></use></svg></div></a></div><div class="CaseStudySliderstyled__SliderWrapper-sc-1h2jznj-4 cJLIbL"><div class="slick-slider slick-initialized" dir="ltr"><div class="slick-list"><div class="slick-track" style="width: 9728px; opacity: 1; transform: translate3d(-1280px, 0px, 0px);"><div data-index="0" class="slick-slide" tabindex="-1" aria-hidden="true" style="outline: none;"><div><div class="Slidestyled__Frame-sc-pvp4zb-0 fqEAnq"><button aria-label="FMLY localiza la causa raíz de un problema." class="Slidestyled__Button-sc-pvp4zb-4 deZfAQ"></button><div class="Slidestyled__Content-sc-pvp4zb-1 ePeYBM"><div class="Slidestyled__Tag-sc-pvp4zb-5 JASqO">Estudio de caso</div><div class="Slidestyled__Heading-sc-pvp4zb-2 iuyURJ">FMLY localiza la causa raíz de un problema.</div><div class="Slidestyled__Subhead-sc-pvp4zb-3 hVWiUs"><p>Después del primer año, FMLY ha sido capaz de entregar resultados increíbles a su cliente de gestión de propiedades, ayudando a proporcionar consejos basados en datos y ahorros significativos en el mantenimiento de los restaurantes, bares y hoteles del cliente.</p></div><a variant="Link - White" aria-label="Leer Estudio de Caso" data-link-type="internal-link" class="CallToActionstyled__applySharedStyles-sc-2h7j2i-0 jiVmWS card-cta " styles="
